# ════════════════════════════════════════════════════════════════
# SUPABASE CONNECTION — READ THIS CAREFULLY
# ════════════════════════════════════════════════════════════════
#
# You need TWO URLs from Supabase:
# Go to: Supabase Dashboard → Your Project → Settings → Database
#
# URL 1: DATABASE_URL (for runtime queries)
#   → Section: "Connection string" → Tab: "Transaction" 
#   → Port MUST be 6543
#   → Add ?pgbouncer=true&connection_limit=1 at the end
#
# URL 2: DIRECT_URL (for migrations / prisma db push)
#   → Section: "Connection string" → Tab: "Direct connection"
#   → Port is 5432
#   → No extra params needed
#
# ════════════════════════════════════════════════════════════════

DATABASE_URL="postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-YOURREGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@db.YOURPROJECTREF.supabase.co:5432/postgres"

JWT_SECRET="change-this-to-any-random-string"
PUBLIC_URL="http://localhost:4000"
NODE_ENV="development"
PORT=4000

ADMIN_PASSWORD="your-admin-password"
PLATFORM_UPI="yourname@paytm"
WHATSAPP_GROUP_LINK="https://chat.whatsapp.com/IhIzKUkd4g9Kvd57HRUMxg?s=sh&p=a&mlu=0"
SUPPORT_EMAIL="tech.support.dev@gmail.com"
FRONTEND_URL="http://localhost:5173"

# CORS lockdown — leave blank while developing locally (falls back to allowing any origin).
# Before going live, set this to your real frontend URL(s), comma-separated if more than one:
# ALLOWED_ORIGINS="https://app.printdrop.in"
ALLOWED_ORIGINS=""

# Used to encrypt each shop's Razorpay Key Secret at rest — MUST be a random 32-byte value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Once set for a real deployment, NEVER change it — doing so makes existing saved keys undecryptable.
ENCRYPTION_KEY="REPLACE_WITH_YOUR_OWN_32_BYTE_KEY"

# Platform Razorpay account — used ONLY for shopkeeper→PrintDrop subscription payments.
# Print payments never touch this account; each shop uses its own keys (set from their dashboard).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook Secret from YOUR Razorpay Dashboard → Settings → Webhooks, after adding:
#   https://your-server.com/api/payment/webhook   (event: payment.captured)
# This is what makes subscription activation automatic — no manual approval step.
RAZORPAY_WEBHOOK_SECRET=""

# Leave blank for local testing (OTP prints in terminal)
# For production: use Gmail App Password
SMTP_USER=""
SMTP_PASS=""
